<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Pass recalibrate:=true to redo paper corner clicks -->
  <arg name="recalibrate" default="false"/>
  
  <!-- D435i Camera Driver -->
  <node pkg="d435i_camera" type="d435i_driver_node.py" name="d435i_driver" output="screen">
    <param name="width" value="1280"/>
    <param name="height" value="720"/>
    <param name="fps" value="30"/>
    <param name="hole_filling" value="true"/>
    <param name="hole_filling_mode" value="1"/>
  </node>
  
  <!-- Camera Calibration (manual) -->
  <node pkg="camera_calibration" type="camera_calibration_node.py" name="camera_calibration" output="screen">
    <param name="paper_x_m"   value="0.850"/>
    <param name="paper_y_m"   value="0.600"/>
    <param name="fx"          value="901.473"/>
    <param name="fy"          value="899.637"/>
    <param name="cx"          value="642.351"/>
    <param name="cy"          value="349.990"/>
    <param name="recalibrate" value="$(arg recalibrate)"/>
  </node>

  <!-- Hand Detection -->
  <node pkg="hand_detection" type="hand_detection_node.py" name="hand_detection" output="screen">
    <param name="detection_confidence" value="0.7"/>
    <param name="tracking_confidence" value="0.5"/>
  </node>
  
  <!-- Finger Analysis -->
  <node pkg="finger_analysis" type="finger_analysis_node.py" name="finger_analysis" output="screen">
    <param name="straightness_threshold" value="0.7"/>
    <param name="fx" value="901.473"/>
    <param name="fy" value="899.637"/>
    <param name="cx" value="642.351"/>
    <param name="cy" value="349.990"/>
    <!-- One Euro Filter for landmark smoothing (knuckle + direction) -->
    <param name="filter_min_cutoff" value="1.0"/>
    <param name="filter_beta" value="0.007"/>
    <param name="filter_d_cutoff" value="1.0"/>
    <!-- One Euro Filter for straightness score -->
    <param name="one_euro_min_cutoff" value="1.0"/>
    <param name="one_euro_beta"       value="0.007"/>
    <param name="one_euro_d_cutoff"   value="1.0"/>
  </node>
  
  <!-- Pointing Localization -->
  <node pkg="pointing_localization" type="pointing_localization_node.py" name="pointing_localization" output="screen">
    <param name="filter_min_cutoff" value="0.1"/>
    <param name="filter_beta" value="0.8"/>
    <param name="filter_d_cutoff" value="1.0"/>
    <!-- Diagnostic: set true to print ray/intersection/uv every 0.5 s and publish /diag/pointing_raw -->
    <param name="diagnose_pointing" value="true"/>
    <!-- Bypass: set true to skip One Euro Filter and publish raw intersection uv directly -->
    <param name="bypass_filters" value="false"/>
  </node>

  <!-- Visualization -->
  <node pkg="visualization" type="visualization_node.py" name="visualization" output="screen">
    <param name="show_landmarks" value="true"/>
    <param name="diagnose_hand" value="false"/>
    <!-- Set true to draw crosshair on the live feed at the raw (u,v) pointing position -->
    <param name="diagnose_pointing" value="true"/>
    <param name="fx" value="901.473"/>
    <param name="fy" value="899.637"/>
    <param name="cx" value="642.351"/>
    <param name="cy" value="349.990"/>
  </node>

  <!-- Sphero Detection (camera-based position tracking) -->
  <node pkg="sphero_detection" type="sphero_detection_node.py" name="sphero_detection" output="screen"/>

  <!-- Sphero Navigate Controller -->
  <node pkg="sphero_pointing" type="sphero_navigate_node.py" name="sphero_navigate" output="screen" launch-prefix="bash -c 'sleep 3; exec $0 $@' ">
    <param name="sphero_name"     value="SB-FD03"/>
    <param name="heading_offset"  value="0.0"/>
    <param name="fx"              value="901.473"/>
    <param name="fy"              value="899.637"/>
    <param name="cx"              value="642.351"/>
    <param name="cy"              value="349.990"/>
  </node>

  <!-- Sphero Pointing Controller (disabled — use sphero_navigate_node instead) -->
  <!--
  <node pkg="sphero_pointing" type="sphero_pointing_node.py" name="sphero_pointing" output="screen">
    <param name="roll_speed"           value="80"/>
    <param name="cm_per_sec"           value="18.18"/>
    <param name="arrival_threshold_cm" value="3.0"/>
    <param name="max_step_s"           value="1.0"/>
    <param name="step_pause_s"         value="0.4"/>
    <param name="paper_x_cm"          value="85.0"/>
    <param name="paper_y_cm"          value="60.0"/>
    <param name="target_hold_time"    value="0.5"/>
  </node>
  -->

</launch>
